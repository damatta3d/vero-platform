{$VERO_PUBLIC_SITE::80}, http://127.0.0.1 {
    encode zstd gzip

    reverse_proxy api:3000

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format console
    }
}
