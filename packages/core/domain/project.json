{
  "name": "core-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/domain",
  "projectType": "library",
  "tags": ["type:domain", "scope:core", "runtime:agnostic", "stability:public"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/core/domain",
        "main": "packages/core/domain/public-api.ts",
        "tsConfig": "packages/core/domain/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/core/domain/**/*.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/core/domain/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/core/domain/jest.config.cjs",
        "coverage": true
      }
    }
  }
}
