generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CatalogUnitOfMeasure {
  UNIT
  GRAM
  KILOGRAM
  MILLILITER
  LITER
}

enum CatalogItemKind {
  INGREDIENT
  PACKAGING
}

enum InventoryStockMovementType {
  PURCHASE_IN
  CONSUMPTION_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model CatalogIngredient {
  id                    String                   @db.Uuid
  tenantId              String                   @db.VarChar(128)
  name                  String                   @db.VarChar(160)
  kind                  CatalogItemKind          @default(INGREDIENT)
  unit                  CatalogUnitOfMeasure
  packageQuantityMicros BigInt
  packageCostCents      Int
  createdAt             DateTime                 @db.Timestamptz(3)
  updatedAt             DateTime                 @db.Timestamptz(3)
  recipeLines           CatalogRecipeLine[]
  stockPosition         InventoryStockPosition?
  stockMovements        InventoryStockMovement[]
  saleCostLines         SalesCostLine[]
  productionCostLines   ProductionCostLine[]

  @@id([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, kind, name])
  @@map("catalog_ingredients")
}

model InventoryStockPosition {
  tenantId              String            @db.VarChar(128)
  ingredientId          String            @db.Uuid
  quantityOnHandMicros  BigInt
  averageUnitCostMicros BigInt
  inventoryValueCents   Int
  lastMovementAt        DateTime?         @db.Timestamptz(3)
  updatedAt             DateTime          @db.Timestamptz(3)
  ingredient            CatalogIngredient @relation(fields: [tenantId, ingredientId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, ingredientId])
  @@map("inventory_stock_positions")
}

model InventoryStockMovement {
  id             String                     @db.Uuid
  tenantId       String                     @db.VarChar(128)
  ingredientId   String                     @db.Uuid
  type           InventoryStockMovementType
  quantityMicros BigInt
  unitCostMicros BigInt
  totalCostCents Int
  reason         String                     @db.VarChar(256)
  authoredBy     String                     @db.VarChar(256)
  occurredAt     DateTime                   @db.Timestamptz(3)
  ingredient     CatalogIngredient          @relation(fields: [tenantId, ingredientId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, ingredientId, occurredAt])
  @@map("inventory_stock_movements")
}

model CatalogProduct {
  id                   String                @db.Uuid
  tenantId             String                @db.VarChar(128)
  name                 String                @db.VarChar(160)
  salePriceCents       Int
  createdAt            DateTime              @db.Timestamptz(3)
  updatedAt            DateTime              @db.Timestamptz(3)
  recipes              CatalogRecipe[]
  sales                SalesRecord[]
  productions          ProductionRecord[]
  externalCatalogLinks ExternalCatalogLink[]

  @@id([tenantId, id])
  @@index([tenantId, name])
  @@map("catalog_products")
}

model CatalogRecipe {
  id          String              @db.Uuid
  tenantId    String              @db.VarChar(128)
  productId   String              @db.Uuid
  version     Int
  yieldUnits  Int
  authoredBy  String              @db.VarChar(256)
  createdAt   DateTime            @db.Timestamptz(3)
  product     CatalogProduct      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lines       CatalogRecipeLine[]
  sales       SalesRecord[]
  productions ProductionRecord[]

  @@id([tenantId, id])
  @@unique([tenantId, productId, version])
  @@map("catalog_recipes")
}

model CatalogRecipeLine {
  tenantId       String            @db.VarChar(128)
  recipeId       String            @db.Uuid
  ingredientId   String            @db.Uuid
  quantityMicros BigInt
  recipe         CatalogRecipe     @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Cascade)
  ingredient     CatalogIngredient @relation(fields: [tenantId, ingredientId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, recipeId, ingredientId])
  @@map("catalog_recipe_lines")
}

model SalesRecord {
  id                 String          @db.Uuid
  tenantId           String          @db.VarChar(128)
  idempotencyKey     String          @db.VarChar(160)
  productId          String          @db.Uuid
  productName        String          @db.VarChar(160)
  recipeId           String          @db.Uuid
  recipeVersion      Int
  quantity           Int
  unitSalePriceCents Int
  grossRevenueCents  Int
  estimatedCmvCents  Int
  realizedCmvCents   Int
  marginCents        Int
  marginBasisPoints  Int
  authoredBy         String          @db.VarChar(256)
  soldAt             DateTime        @db.Timestamptz(3)
  product            CatalogProduct  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  recipe             CatalogRecipe   @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Restrict)
  costLines          SalesCostLine[]

  @@id([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, soldAt])
  @@map("sales_records")
}

model SalesCostLine {
  tenantId                String            @db.VarChar(128)
  saleId                  String            @db.Uuid
  ingredientId            String            @db.Uuid
  movementId              String            @db.Uuid
  quantityMicros          BigInt
  estimatedUnitCostMicros BigInt
  realizedUnitCostMicros  BigInt
  estimatedCostCents      Int
  realizedCostCents       Int
  sale                    SalesRecord       @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  ingredient              CatalogIngredient @relation(fields: [tenantId, ingredientId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, saleId, ingredientId])
  @@unique([tenantId, movementId])
  @@map("sales_cost_lines")
}

model ProductionRecord {
  id                String               @db.Uuid
  tenantId          String               @db.VarChar(128)
  idempotencyKey    String               @db.VarChar(160)
  productId         String               @db.Uuid
  productName       String               @db.VarChar(160)
  recipeId          String               @db.Uuid
  recipeVersion     Int
  yieldUnits        Int
  quantity          Int
  estimatedCmvCents Int
  realizedCmvCents  Int
  authoredBy        String               @db.VarChar(256)
  producedAt        DateTime             @db.Timestamptz(3)
  product           CatalogProduct       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  recipe            CatalogRecipe        @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Restrict)
  costLines         ProductionCostLine[]

  @@id([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, producedAt])
  @@map("production_records")
}

model ProductionCostLine {
  tenantId                String            @db.VarChar(128)
  productionId            String            @db.Uuid
  ingredientId            String            @db.Uuid
  movementId              String            @db.Uuid
  quantityMicros          BigInt
  estimatedUnitCostMicros BigInt
  realizedUnitCostMicros  BigInt
  estimatedCostCents      Int
  realizedCostCents       Int
  production              ProductionRecord  @relation(fields: [tenantId, productionId], references: [tenantId, id], onDelete: Restrict)
  ingredient              CatalogIngredient @relation(fields: [tenantId, ingredientId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, productionId, ingredientId])
  @@unique([tenantId, movementId])
  @@map("production_cost_lines")
}

model ExternalCatalogLink {
  tenantId                String         @db.VarChar(128)
  provider                String         @db.VarChar(64)
  establishmentExternalId String         @db.VarChar(256)
  kind                    String         @db.VarChar(16)
  providerItemId          String         @db.VarChar(256)
  catalogProductId        String         @db.Uuid
  authoredBy              String         @db.VarChar(256)
  createdAt               DateTime       @db.Timestamptz(3)
  updatedAt               DateTime       @db.Timestamptz(3)
  catalogProduct          CatalogProduct @relation(fields: [tenantId, catalogProductId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, provider, establishmentExternalId, kind, providerItemId])
  @@index([tenantId, catalogProductId])
  @@map("external_catalog_links")
}

model StoreSettings {
  tenantId                  String                @id @map("tenant_id") @db.VarChar(128)
  displayName               String                @map("display_name") @db.VarChar(160)
  phone                     String?               @db.VarChar(32)
  whatsapp                  String?               @db.VarChar(32)
  address                   String?               @db.VarChar(240)
  addressComplement         String?               @map("address_complement") @db.VarChar(160)
  neighborhood              String?               @db.VarChar(120)
  city                      String?               @db.VarChar(120)
  stateCode                 String?               @map("state_code") @db.Char(2)
  postalCode                String?               @map("postal_code") @db.VarChar(9)
  operationallyOpen         Boolean               @default(false) @map("operationally_open")
  pickupEnabled             Boolean               @default(true) @map("pickup_enabled")
  deliveryEnabled           Boolean               @default(false) @map("delivery_enabled")
  preparationTimeMinMinutes Int                   @default(30) @map("preparation_time_min_minutes")
  preparationTimeMaxMinutes Int                   @default(60) @map("preparation_time_max_minutes")
  minimumOrderCents         Int                   @default(0) @map("minimum_order_cents")
  orderReceiptMode          String                @default("MANUAL") @map("order_receipt_mode") @db.VarChar(16)
  timezone                  String                @default("America/Campo_Grande") @db.VarChar(64)
  deliveryRadiusKm          Float?                @map("delivery_radius_km")
  deliveryBaseFeeCents      Int                   @default(0) @map("delivery_base_fee_cents")
  freeDeliveryAboveCents    Int?                  @map("free_delivery_above_cents")
  pixEnabled                Boolean               @default(true) @map("pix_enabled")
  paymentOnDeliveryEnabled  Boolean               @default(false) @map("payment_on_delivery_enabled")
  cashOnDeliveryEnabled     Boolean               @default(false) @map("cash_on_delivery_enabled")
  cardOnDeliveryEnabled     Boolean               @default(false) @map("card_on_delivery_enabled")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime              @default(now()) @map("updated_at") @db.Timestamptz(3)
  scheduleWindows           StoreScheduleWindow[]

  @@map("store_settings")
}

model StoreScheduleWindow {
  tenantId String        @map("tenant_id") @db.VarChar(128)
  weekday  Int           @db.SmallInt
  sequence Int           @default(0) @db.SmallInt
  enabled  Boolean       @default(false)
  opensAt  DateTime?     @map("opens_at") @db.Time(0)
  closesAt DateTime?     @map("closes_at") @db.Time(0)
  settings StoreSettings @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@id([tenantId, weekday, sequence])
  @@index([tenantId, weekday])
  @@map("store_schedule_windows")
}

model ExternalOrderInbox {
  id                      String                 @id @default(uuid()) @db.Uuid
  tenantId                String                 @db.VarChar(128)
  provider                String                 @db.VarChar(64)
  establishmentExternalId String                 @db.VarChar(256)
  externalOrderId         String                 @db.VarChar(256)
  reference               String                 @db.VarChar(128)
  customerDisplayName     String?                @db.VarChar(80)
  orderType               String                 @db.VarChar(128)
  salesChannel            String                 @db.VarChar(128)
  currency                String                 @db.Char(3)
  subtotalCents           Int
  discountCents           Int
  deliveryFeeCents        Int
  additionalFeesCents     Int
  totalCents              Int
  items                   Json
  operationalStatus       String                 @db.VarChar(32)
  providerStatus          String?                @db.VarChar(128)
  mappingStatus           String                 @db.VarChar(32)
  occurredAt              DateTime               @db.Timestamptz(3)
  lastObservedAt          DateTime               @db.Timestamptz(3)
  sourceRevision          String                 @db.VarChar(256)
  statusUpdatedAt         DateTime               @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(3)
  receipts                ExternalOrderReceipt[]

  @@unique([tenantId, provider, establishmentExternalId, externalOrderId])
  @@index([tenantId, occurredAt, id])
  @@index([tenantId, provider, operationalStatus, occurredAt])
  @@index([tenantId, mappingStatus, occurredAt])
  @@map("external_order_inbox")
}

model ExternalOrderReceipt {
  id             String             @id @default(uuid()) @db.Uuid
  orderId        String             @db.Uuid
  sourceRevision String             @db.VarChar(256)
  observedAt     DateTime           @db.Timestamptz(3)
  occurredAt     DateTime           @db.Timestamptz(3)
  providerStatus String?            @db.VarChar(128)
  payloadHash    String             @db.Char(64)
  snapshot       Json
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  order          ExternalOrderInbox @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, sourceRevision])
  @@index([orderId, observedAt])
  @@map("external_order_receipts")
}
