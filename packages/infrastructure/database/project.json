{
  "name": "infrastructure-database",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/infrastructure/database/src",
  "projectType": "library",
  "tags": ["type:infrastructure", "scope:platform", "runtime:node", "stability:public"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/infrastructure/database",
        "rootDir": ".",
        "main": "packages/infrastructure/database/src/public-api.ts",
        "tsConfig": "packages/infrastructure/database/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/infrastructure/database/**/*.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/infrastructure/database/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/infrastructure/database/jest.config.cjs",
        "passWithNoTests": true
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prisma generate"
      }
    },
    "prisma-validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prisma validate"
      }
    },
    "prisma-format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prisma format"
      }
    },
    "prisma-migrate-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prisma migrate dev"
      }
    },
    "prisma-migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prisma migrate deploy"
      }
    },
    "prisma-db-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prisma db push"
      }
    },
    "prisma-studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prisma studio"
      }
    }
  }
}
