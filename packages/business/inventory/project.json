{
  "name": "business-inventory",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/business/inventory/src",
  "projectType": "library",
  "tags": ["type:business", "scope:business", "runtime:agnostic", "stability:public"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/business/inventory",
        "main": "packages/business/inventory/src/public-api.ts",
        "tsConfig": "packages/business/inventory/tsconfig.lib.json",
        "platform": "node",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": false,
        "generatePackageJson": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": { "lintFilePatterns": ["packages/business/inventory/src/**/*.ts"] }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/business/inventory/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/business/inventory/jest.config.cjs",
        "coverage": true
      }
    }
  }
}
