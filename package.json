{
  "name": "@vero/platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint --parallel=1",
    "test": "nx run-many -t test",
    "test:integration": "jest --config tests/integration/jest.config.cjs --runInBand",
    "anota-ai:smoke": "node tools/anota-ai/smoke.cjs",
    "test:architecture": "node tools/validation/architecture.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "audit": "pnpm audit --audit-level high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:architecture && pnpm build",
    "prisma:generate": "prisma generate",
    "start:api": "node dist/apps/api/main.cjs",
    "start:worker": "node dist/apps/worker/main.cjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/terminus": "11.1.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.5.0",
    "@opentelemetry/sdk-metrics": "2.5.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.38.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "amqplib": "0.10.9",
    "fastify": "5.10.0",
    "ioredis": "5.8.2",
    "nestjs-pino": "4.6.1",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@eslint/js": "9.39.2",
    "@nestjs/testing": "11.1.28",
    "@nx/esbuild": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/node": "23.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.11",
    "@swc/helpers": "0.5.18",
    "@types/amqplib": "0.10.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.13",
    "@types/pg": "8.15.6",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "esbuild": "0.28.1",
    "globals": "17.3.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "nx": "23.1.0",
    "prettier": "3.8.1",
    "prisma": "7.9.1",
    "ts-jest": "29.4.6",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  }
}
